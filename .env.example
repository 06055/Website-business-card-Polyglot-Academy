# Polyglot Academy - business-card website (Flask). Copy to .env only if you need to change a default.
# The site has no application database or authentication.

# Development server only (python main.py). Production uses gunicorn from the Dockerfile.
HOST=127.0.0.1
PORT=5000
# 1 = Flask debug (development). Never 1 on the server.
FLASK_DEBUG=1

# Production (docker compose): the number of gunicorn workers. 2 is plenty for a static landing page.
WEB_CONCURRENCY=2

# Optional production GeoIP. Download GeoLite2-Country.mmdb separately; it is not committed.
# Example container path: /app/data/GeoLite2-Country.mmdb
GEOIP_COUNTRY_DB=
# Only these direct peers may supply X-Forwarded-For. Set this to Caddy's actual network/CIDR.
# Local-only example: 127.0.0.0/8,::1/128
TRUSTED_PROXY_CIDRS=
